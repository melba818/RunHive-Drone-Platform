{
    "name": "runhive/backend",
    "description": "RunHive portal and business backend (ThinkPHP / BuildAdmin based).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0.0",
        "aliyuncs/oss-sdk-php": "2.7.3",
        "nelexa/zip": "4.0.2",
        "phpmailer/phpmailer": "6.12.0",
        "phpoffice/phpspreadsheet": "5.10.0",
        "ramsey/uuid": "4.9.4",
        "topthink/framework": "8.1.1",
        "topthink/think-migration": "3.1.1",
        "topthink/think-multi-app": "1.1.1",
        "topthink/think-orm": "3.0.33",
        "topthink/think-throttle": "2.0.2",
        "topthink/think-worker": "4.0.0",
        "voku/anti-xss": "4.1.44",
        "workerman/mqtt": "1.7"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/",
            "modules\\": "modules/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover"
        ]
    }
}