# Copy to .env (in this quickstart/ directory) and fill in YOUR OWN model
# provider key if you want the AI features (Copilot, AI annotation, chat)
# to actually call a model. Everything else runs without it.
# Never commit your real .env — it is git-ignored.
RUNHIVE_LLM_API_KEY=
RUNHIVE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RUNHIVE_LLM_MODEL=qwen-vl-max
